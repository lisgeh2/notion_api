[Unit]
Description=Phone tracking endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phonetrack
Group=phonetrack
WorkingDirectory=/opt/phonetrack
Environment=TRACK_DB=/var/lib/phonetrack/phonetrack.db
Environment=TRACK_HOST=127.0.0.1
Environment=TRACK_PORT=8080
Environment=TRACK_STALE_MIN=15
# Put TRACK_TOKEN in this file (mode 0600), NOT in the unit — units are world-readable.
EnvironmentFile=/etc/phonetrack.env
ExecStart=/opt/phonetrack/venv/bin/python /opt/phonetrack/server.py
Restart=always
RestartSec=5

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/phonetrack
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
